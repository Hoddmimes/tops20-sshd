	TITLE	FE25519 - arithmetic in GF(2^255-19) for TOPS-20
	SUBTTL	Generated by tools/genfe.py from tools/fe25519.tmpl

;Field elements are 10 words: signed limbs of alternately 26 and 25
;bits (ref10 representation), value = sum h[i] * 2^ceil(25.5*i).
;
;FMUL forms the 100 limb products with MUL (exact 70-bit results),
;sums each column with DADD and carries with ASHC on the double words.
;
;Calls (clobber T1-T4 only; destinations may alias sources):
;  T1/ h  T2/ f  T3/ g    FMUL  h = f*g      FADD  h = f+g
;                         FSUB  h = f-g
;  T1/ h  T2/ f           FSQ   h = f^2      FCOPY h = f
;                         FNEG  h = -f       FINV  h = 1/f
;  T1/ h                  FZERO h = 0        FONE  h = 1
;  T1/ f  T2/ g  T3/ bit  FCSWAP  swap f and g if bit = 1 (constant time)
;  T1/ bytes  T2/ h       FTOBYT  32-byte little-endian canonical encoding
;  T1/ h  T2/ bytes       FFRBYT  decode 32 bytes (bit 255 ignored)
;Bytes are one per word.

	SEARCH	MONSYM,MACSYM
	SALL

	INTERN	FMUL,FSQ,FADD,FSUB,FCOPY,FNEG,FINV,FZERO,FONE
	INTERN	FCSWAP,FTOBYT,FFRBYT

	T1=1
	T2=2
	T3=3
	T4=4
	A=5			;Pairs: (A,A1) (B,B1) (C,C1) (D,D1)
	A1=6
	B=7
	B1=10
	C=11
	C1=12
	D=13
	D1=14
	I=15
	P=17

DEFINE	SAVREG,<
	PUSH	P,5
	PUSH	P,6
	PUSH	P,7
	PUSH	P,10
	PUSH	P,11
	PUSH	P,12
	PUSH	P,13
	PUSH	P,14
	PUSH	P,15
>
DEFINE	RSTREG,<
	POP	P,15
	POP	P,14
	POP	P,13
	POP	P,12
	POP	P,11
	POP	P,10
	POP	P,7
	POP	P,6
	POP	P,5
>

DST:	BLOCK	1
FF:	BLOCK	12		;f
F2:	BLOCK	12		;2*f
GG:	BLOCK	12		;g
G19:	BLOCK	12		;19*g
HH:	BLOCK	24		;Column sums, double words
HS:	BLOCK	12		;FTOBYT work copy
ZZ:	BLOCK	12		;FINV temporaries
IT0:	BLOCK	12
IT1:	BLOCK	12
IT2:	BLOCK	12
IT3:	BLOCK	12
IT4:	BLOCK	12
RND26:	0			;2^25 as a double word
	200000000
RND25:	0			;2^24 as a double word
	100000000

;Limb widths, negated widths and masks

LWID:	REPEAT	5,<^D26
	^D25>
NWID:	REPEAT	5,<-^D26
	-^D25>
WMASK:	REPEAT	5,<377777777
	177777777>

SUBTTL	FMUL, FSQ

FSQ:	MOVE	T3,T2
FMUL:	SAVREG
	MOVEM	T1,DST
	MOVSI	I,-12		;Copy f, 2f, g, 19g
FMUL1:	MOVE	T4,(T2)
	MOVEM	T4,FF(I)
	ASH	T4,1
	MOVEM	T4,F2(I)
	MOVE	T4,(T3)
	MOVEM	T4,GG(I)
	IMULI	T4,^D19
	MOVEM	T4,G19(I)
	ADDI	T2,1
	ADDI	T3,1
	AOBJN	I,FMUL1
;--- generated: 100 products, column k accumulated in (A,A1) ---
	SETZB	A,A1		;h0
	MOVE	B,FF+0
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,F2+1
	MUL	B,G19+11
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,G19+10
	DADD	A,B
	MOVE	B,F2+3
	MUL	B,G19+7
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,G19+6
	DADD	A,B
	MOVE	B,F2+5
	MUL	B,G19+5
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,G19+4
	DADD	A,B
	MOVE	B,F2+7
	MUL	B,G19+3
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,G19+2
	DADD	A,B
	MOVE	B,F2+11
	MUL	B,G19+1
	DADD	A,B
	DMOVEM	A,HH+0
	SETZB	A,A1		;h1
	MOVE	B,FF+0
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+1
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,G19+11
	DADD	A,B
	MOVE	B,FF+3
	MUL	B,G19+10
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,G19+7
	DADD	A,B
	MOVE	B,FF+5
	MUL	B,G19+6
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,G19+5
	DADD	A,B
	MOVE	B,FF+7
	MUL	B,G19+4
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,G19+3
	DADD	A,B
	MOVE	B,FF+11
	MUL	B,G19+2
	DADD	A,B
	DMOVEM	A,HH+2
	SETZB	A,A1		;h2
	MOVE	B,FF+0
	MUL	B,GG+2
	DADD	A,B
	MOVE	B,F2+1
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,F2+3
	MUL	B,G19+11
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,G19+10
	DADD	A,B
	MOVE	B,F2+5
	MUL	B,G19+7
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,G19+6
	DADD	A,B
	MOVE	B,F2+7
	MUL	B,G19+5
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,G19+4
	DADD	A,B
	MOVE	B,F2+11
	MUL	B,G19+3
	DADD	A,B
	DMOVEM	A,HH+4
	SETZB	A,A1		;h3
	MOVE	B,FF+0
	MUL	B,GG+3
	DADD	A,B
	MOVE	B,FF+1
	MUL	B,GG+2
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+3
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,G19+11
	DADD	A,B
	MOVE	B,FF+5
	MUL	B,G19+10
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,G19+7
	DADD	A,B
	MOVE	B,FF+7
	MUL	B,G19+6
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,G19+5
	DADD	A,B
	MOVE	B,FF+11
	MUL	B,G19+4
	DADD	A,B
	DMOVEM	A,HH+6
	SETZB	A,A1		;h4
	MOVE	B,FF+0
	MUL	B,GG+4
	DADD	A,B
	MOVE	B,F2+1
	MUL	B,GG+3
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,GG+2
	DADD	A,B
	MOVE	B,F2+3
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,F2+5
	MUL	B,G19+11
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,G19+10
	DADD	A,B
	MOVE	B,F2+7
	MUL	B,G19+7
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,G19+6
	DADD	A,B
	MOVE	B,F2+11
	MUL	B,G19+5
	DADD	A,B
	DMOVEM	A,HH+10
	SETZB	A,A1		;h5
	MOVE	B,FF+0
	MUL	B,GG+5
	DADD	A,B
	MOVE	B,FF+1
	MUL	B,GG+4
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,GG+3
	DADD	A,B
	MOVE	B,FF+3
	MUL	B,GG+2
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+5
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,G19+11
	DADD	A,B
	MOVE	B,FF+7
	MUL	B,G19+10
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,G19+7
	DADD	A,B
	MOVE	B,FF+11
	MUL	B,G19+6
	DADD	A,B
	DMOVEM	A,HH+12
	SETZB	A,A1		;h6
	MOVE	B,FF+0
	MUL	B,GG+6
	DADD	A,B
	MOVE	B,F2+1
	MUL	B,GG+5
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,GG+4
	DADD	A,B
	MOVE	B,F2+3
	MUL	B,GG+3
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,GG+2
	DADD	A,B
	MOVE	B,F2+5
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,F2+7
	MUL	B,G19+11
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,G19+10
	DADD	A,B
	MOVE	B,F2+11
	MUL	B,G19+7
	DADD	A,B
	DMOVEM	A,HH+14
	SETZB	A,A1		;h7
	MOVE	B,FF+0
	MUL	B,GG+7
	DADD	A,B
	MOVE	B,FF+1
	MUL	B,GG+6
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,GG+5
	DADD	A,B
	MOVE	B,FF+3
	MUL	B,GG+4
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,GG+3
	DADD	A,B
	MOVE	B,FF+5
	MUL	B,GG+2
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+7
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,G19+11
	DADD	A,B
	MOVE	B,FF+11
	MUL	B,G19+10
	DADD	A,B
	DMOVEM	A,HH+16
	SETZB	A,A1		;h8
	MOVE	B,FF+0
	MUL	B,GG+10
	DADD	A,B
	MOVE	B,F2+1
	MUL	B,GG+7
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,GG+6
	DADD	A,B
	MOVE	B,F2+3
	MUL	B,GG+5
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,GG+4
	DADD	A,B
	MOVE	B,F2+5
	MUL	B,GG+3
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,GG+2
	DADD	A,B
	MOVE	B,F2+7
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,GG+0
	DADD	A,B
	MOVE	B,F2+11
	MUL	B,G19+11
	DADD	A,B
	DMOVEM	A,HH+20
	SETZB	A,A1		;h9
	MOVE	B,FF+0
	MUL	B,GG+11
	DADD	A,B
	MOVE	B,FF+1
	MUL	B,GG+10
	DADD	A,B
	MOVE	B,FF+2
	MUL	B,GG+7
	DADD	A,B
	MOVE	B,FF+3
	MUL	B,GG+6
	DADD	A,B
	MOVE	B,FF+4
	MUL	B,GG+5
	DADD	A,B
	MOVE	B,FF+5
	MUL	B,GG+4
	DADD	A,B
	MOVE	B,FF+6
	MUL	B,GG+3
	DADD	A,B
	MOVE	B,FF+7
	MUL	B,GG+2
	DADD	A,B
	MOVE	B,FF+10
	MUL	B,GG+1
	DADD	A,B
	MOVE	B,FF+11
	MUL	B,GG+0
	DADD	A,B
	DMOVEM	A,HH+22
;--- generated: carry chain on the double words ---
	DMOVE	A,HH+0		;carry h0 -> h1
	DADD	A,RND26
	DMOVE	C,A
	ASHC	A,-^D26
	DMOVE	B,HH+2
	DADD	B,A
	DMOVEM	B,HH+2
	MOVE	B1,C1		;h0 := ((h0 + rnd) mod 2^26) - 2^25
	AND	B1,[377777777]
	SUB	B1,[200000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+0
	DMOVE	A,HH+10		;carry h4 -> h5
	DADD	A,RND26
	DMOVE	C,A
	ASHC	A,-^D26
	DMOVE	B,HH+12
	DADD	B,A
	DMOVEM	B,HH+12
	MOVE	B1,C1		;h4 := ((h4 + rnd) mod 2^26) - 2^25
	AND	B1,[377777777]
	SUB	B1,[200000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+10
	DMOVE	A,HH+2		;carry h1 -> h2
	DADD	A,RND25
	DMOVE	C,A
	ASHC	A,-^D25
	DMOVE	B,HH+4
	DADD	B,A
	DMOVEM	B,HH+4
	MOVE	B1,C1		;h1 := ((h1 + rnd) mod 2^25) - 2^24
	AND	B1,[177777777]
	SUB	B1,[100000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+2
	DMOVE	A,HH+12		;carry h5 -> h6
	DADD	A,RND25
	DMOVE	C,A
	ASHC	A,-^D25
	DMOVE	B,HH+14
	DADD	B,A
	DMOVEM	B,HH+14
	MOVE	B1,C1		;h5 := ((h5 + rnd) mod 2^25) - 2^24
	AND	B1,[177777777]
	SUB	B1,[100000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+12
	DMOVE	A,HH+4		;carry h2 -> h3
	DADD	A,RND26
	DMOVE	C,A
	ASHC	A,-^D26
	DMOVE	B,HH+6
	DADD	B,A
	DMOVEM	B,HH+6
	MOVE	B1,C1		;h2 := ((h2 + rnd) mod 2^26) - 2^25
	AND	B1,[377777777]
	SUB	B1,[200000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+4
	DMOVE	A,HH+14		;carry h6 -> h7
	DADD	A,RND26
	DMOVE	C,A
	ASHC	A,-^D26
	DMOVE	B,HH+16
	DADD	B,A
	DMOVEM	B,HH+16
	MOVE	B1,C1		;h6 := ((h6 + rnd) mod 2^26) - 2^25
	AND	B1,[377777777]
	SUB	B1,[200000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+14
	DMOVE	A,HH+6		;carry h3 -> h4
	DADD	A,RND25
	DMOVE	C,A
	ASHC	A,-^D25
	DMOVE	B,HH+10
	DADD	B,A
	DMOVEM	B,HH+10
	MOVE	B1,C1		;h3 := ((h3 + rnd) mod 2^25) - 2^24
	AND	B1,[177777777]
	SUB	B1,[100000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+6
	DMOVE	A,HH+16		;carry h7 -> h8
	DADD	A,RND25
	DMOVE	C,A
	ASHC	A,-^D25
	DMOVE	B,HH+20
	DADD	B,A
	DMOVEM	B,HH+20
	MOVE	B1,C1		;h7 := ((h7 + rnd) mod 2^25) - 2^24
	AND	B1,[177777777]
	SUB	B1,[100000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+16
	DMOVE	A,HH+10		;carry h4 -> h5
	DADD	A,RND26
	DMOVE	C,A
	ASHC	A,-^D26
	DMOVE	B,HH+12
	DADD	B,A
	DMOVEM	B,HH+12
	MOVE	B1,C1		;h4 := ((h4 + rnd) mod 2^26) - 2^25
	AND	B1,[377777777]
	SUB	B1,[200000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+10
	DMOVE	A,HH+20		;carry h8 -> h9
	DADD	A,RND26
	DMOVE	C,A
	ASHC	A,-^D26
	DMOVE	B,HH+22
	DADD	B,A
	DMOVEM	B,HH+22
	MOVE	B1,C1		;h8 := ((h8 + rnd) mod 2^26) - 2^25
	AND	B1,[377777777]
	SUB	B1,[200000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+20
	DMOVE	A,HH+22		;carry h9 -> h0 * 19
	DADD	A,RND25
	DMOVE	C,A
	ASHC	A,-^D25
	DMOVE	B,A		;carry * 19 = 16c + 2c + c
	ASHC	B,4
	DMOVE	D,A
	ASHC	D,1
	DADD	B,D
	DADD	A,B
	DMOVE	B,HH+0
	DADD	B,A
	DMOVEM	B,HH+0
	MOVE	B1,C1		;h9 := ((h9 + rnd) mod 2^25) - 2^24
	AND	B1,[177777777]
	SUB	B1,[100000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+22
	DMOVE	A,HH+0		;carry h0 -> h1
	DADD	A,RND26
	DMOVE	C,A
	ASHC	A,-^D26
	DMOVE	B,HH+2
	DADD	B,A
	DMOVEM	B,HH+2
	MOVE	B1,C1		;h0 := ((h0 + rnd) mod 2^26) - 2^25
	AND	B1,[377777777]
	SUB	B1,[200000000]
	MOVE	B,B1
	ASH	B,-^D35
	DMOVEM	B,HH+0
	MOVE	T1,DST		;Store the low words: all limbs are small now
	MOVEI	T2,HH+1
	MOVSI	I,-12
FMUL2:	MOVE	T4,(T2)
	MOVEM	T4,(T1)
	ADDI	T2,2
	ADDI	T1,1
	AOBJN	I,FMUL2
	RSTREG
	RET

SUBTTL	FADD, FSUB, FNEG, FCOPY, FZERO, FONE, FCSWAP

FADD:	PUSH	P,A
	MOVEI	T4,12
FADD1:	MOVE	A,(T2)
	ADD	A,(T3)
	MOVEM	A,(T1)
	ADDI	T1,1
	ADDI	T2,1
	ADDI	T3,1
	SOJG	T4,FADD1
	POP	P,A
	RET

FSUB:	PUSH	P,A
	MOVEI	T4,12
FSUB1:	MOVE	A,(T2)
	SUB	A,(T3)
	MOVEM	A,(T1)
	ADDI	T1,1
	ADDI	T2,1
	ADDI	T3,1
	SOJG	T4,FSUB1
	POP	P,A
	RET

FNEG:	MOVEI	T4,12
FNEG1:	MOVN	T3,(T2)
	MOVEM	T3,(T1)
	ADDI	T1,1
	ADDI	T2,1
	SOJG	T4,FNEG1
	RET

FCOPY:	MOVEI	T4,12
FCOPY1:	MOVE	T3,(T2)
	MOVEM	T3,(T1)
	ADDI	T1,1
	ADDI	T2,1
	SOJG	T4,FCOPY1
	RET

FZERO:	MOVEI	T4,12
FZERO1:	SETZM	(T1)
	ADDI	T1,1
	SOJG	T4,FZERO1
	RET

FONE:	PUSH	P,T1
	CALL	FZERO
	POP	P,T1
	MOVEI	T4,1
	MOVEM	T4,(T1)
	RET

FCSWAP:	PUSH	P,A
	MOVN	T3,T3		;Mask: 0 or all ones
	MOVEI	T4,12
FCSWA1:	MOVE	A,(T1)
	XOR	A,(T2)
	AND	A,T3
	XORM	A,(T1)
	XORM	A,(T2)
	ADDI	T1,1
	ADDI	T2,1
	SOJG	T4,FCSWA1
	POP	P,A
	RET

SUBTTL	FINV

;FINV - h = f^(p-2) by ref10's addition chain (254 squarings, 11 mults)

FINV:	SAVREG
	MOVEM	T1,DST
	MOVEI	T1,ZZ		;Work on a copy so h may alias f
	CALL	FCOPY
	PUSH	P,DST		;FMUL overwrites DST
	MOVEI	T1,IT0		;t0 = z ^ (2^1)
	MOVEI	T2,ZZ
	CALL	FSQ
	MOVEI	T1,IT1		;t1 = t0 ^ (2^2)
	MOVEI	T2,IT0
	CALL	FSQ
	MOVEI	D,^D1
IV7:	MOVEI	T1,IT1
	MOVEI	T2,IT1
	CALL	FSQ
	SOJG	D,IV7
	MOVEI	T1,IT1		;t1 = z * t1
	MOVEI	T2,ZZ
	MOVEI	T3,IT1
	CALL	FMUL
	MOVEI	T1,IT0		;t0 = t0 * t1
	MOVEI	T2,IT0
	MOVEI	T3,IT1
	CALL	FMUL
	MOVEI	T1,IT2		;t2 = t0 ^ (2^1)
	MOVEI	T2,IT0
	CALL	FSQ
	MOVEI	T1,IT1		;t1 = t1 * t2
	MOVEI	T2,IT1
	MOVEI	T3,IT2
	CALL	FMUL
	MOVEI	T1,IT2		;t2 = t1 ^ (2^5)
	MOVEI	T2,IT1
	CALL	FSQ
	MOVEI	D,^D4
IV30:	MOVEI	T1,IT2
	MOVEI	T2,IT2
	CALL	FSQ
	SOJG	D,IV30
	MOVEI	T1,IT1		;t1 = t2 * t1
	MOVEI	T2,IT2
	MOVEI	T3,IT1
	CALL	FMUL
	MOVEI	T1,IT2		;t2 = t1 ^ (2^10)
	MOVEI	T2,IT1
	CALL	FSQ
	MOVEI	D,^D9
IV42:	MOVEI	T1,IT2
	MOVEI	T2,IT2
	CALL	FSQ
	SOJG	D,IV42
	MOVEI	T1,IT2		;t2 = t2 * t1
	MOVEI	T2,IT2
	MOVEI	T3,IT1
	CALL	FMUL
	MOVEI	T1,IT3		;t3 = t2 ^ (2^20)
	MOVEI	T2,IT2
	CALL	FSQ
	MOVEI	D,^D19
IV54:	MOVEI	T1,IT3
	MOVEI	T2,IT3
	CALL	FSQ
	SOJG	D,IV54
	MOVEI	T1,IT2		;t2 = t3 * t2
	MOVEI	T2,IT3
	MOVEI	T3,IT2
	CALL	FMUL
	MOVEI	T1,IT2		;t2 = t2 ^ (2^10)
	MOVEI	T2,IT2
	CALL	FSQ
	MOVEI	D,^D9
IV66:	MOVEI	T1,IT2
	MOVEI	T2,IT2
	CALL	FSQ
	SOJG	D,IV66
	MOVEI	T1,IT1		;t1 = t2 * t1
	MOVEI	T2,IT2
	MOVEI	T3,IT1
	CALL	FMUL
	MOVEI	T1,IT2		;t2 = t1 ^ (2^50)
	MOVEI	T2,IT1
	CALL	FSQ
	MOVEI	D,^D49
IV78:	MOVEI	T1,IT2
	MOVEI	T2,IT2
	CALL	FSQ
	SOJG	D,IV78
	MOVEI	T1,IT2		;t2 = t2 * t1
	MOVEI	T2,IT2
	MOVEI	T3,IT1
	CALL	FMUL
	MOVEI	T1,IT3		;t3 = t2 ^ (2^100)
	MOVEI	T2,IT2
	CALL	FSQ
	MOVEI	D,^D99
IV90:	MOVEI	T1,IT3
	MOVEI	T2,IT3
	CALL	FSQ
	SOJG	D,IV90
	MOVEI	T1,IT2		;t2 = t3 * t2
	MOVEI	T2,IT3
	MOVEI	T3,IT2
	CALL	FMUL
	MOVEI	T1,IT2		;t2 = t2 ^ (2^50)
	MOVEI	T2,IT2
	CALL	FSQ
	MOVEI	D,^D49
IV102:	MOVEI	T1,IT2
	MOVEI	T2,IT2
	CALL	FSQ
	SOJG	D,IV102
	MOVEI	T1,IT1		;t1 = t2 * t1
	MOVEI	T2,IT2
	MOVEI	T3,IT1
	CALL	FMUL
	MOVEI	T1,IT1		;t1 = t1 ^ (2^5)
	MOVEI	T2,IT1
	CALL	FSQ
	MOVEI	D,^D4
IV114:	MOVEI	T1,IT1
	MOVEI	T2,IT1
	CALL	FSQ
	SOJG	D,IV114
	MOVEI	T1,IT4		;out = t1 * t0
	MOVEI	T2,IT1
	MOVEI	T3,IT0
	CALL	FMUL
	POP	P,T1
	MOVEI	T2,IT4
	CALL	FCOPY
	RSTREG
	RET

SUBTTL	FTOBYT, FFRBYT

;FTOBYT - canonical little-endian encoding (ref10 fe_tobytes)

FTOBYT:	SAVREG
	PUSH	P,T1		;Output address
	MOVEI	T1,HS
	CALL	FCOPY
	MOVE	A,HS+11		;q = (19*h9 + 2^24) >> 25
	IMULI	A,^D19
	ADD	A,[100000000]
	ASH	A,-^D25
	MOVSI	I,-12		;q = (h[i] + q) >> W[i], i = 0..9
FTOBY1:	ADD	A,HS(I)
	MOVE	B,NWID(I)
	ASH	A,(B)
	AOBJN	I,FTOBY1
	IMULI	A,^D19		;h0 += 19*q
	ADDM	A,HS
	MOVSI	I,-11		;Carry h0..h8 upward
FTOBY2:	MOVE	A,HS(I)
	MOVE	B,NWID(I)
	ASH	A,(B)
	ADDM	A,HS+1(I)
	MOVE	A,HS(I)
	AND	A,WMASK(I)
	MOVEM	A,HS(I)
	AOBJN	I,FTOBY2
	MOVE	A,HS+11		;h9 mod 2^25
	AND	A,WMASK+11
	MOVEM	A,HS+11
	POP	P,T4		;Pack the limbs into bytes
	SETZB	C,D		;C = bit accumulator, D = bits in it
	MOVSI	I,-12
FTOBY3:	MOVE	A,HS(I)
	LSH	A,(D)
	IOR	C,A
	ADD	D,LWID(I)
FTOBY4:	CAIGE	D,^D8
	 JRST	FTOBY5
	MOVE	A,C
	ANDI	A,377
	MOVEM	A,(T4)
	ADDI	T4,1
	LSH	C,-^D8
	SUBI	D,^D8
	JRST	FTOBY4
FTOBY5:	AOBJN	I,FTOBY3
	ANDI	C,377		;Last 7 bits
	MOVEM	C,(T4)
	RSTREG
	RET

;FFRBYT - decode 32 little-endian bytes, ignoring bit 255

FFRBYT:	SAVREG
	SETZB	C,D		;C = bit accumulator, D = bits in it
	MOVSI	I,-12
FFRBY1:	CAML	D,LWID(I)	;Enough bits for this limb?
	 JRST	FFRBY2
	MOVE	A,(T2)		;No, take another byte
	ADDI	T2,1
	LSH	A,(D)
	IOR	C,A
	ADDI	D,^D8
	JRST	FFRBY1
FFRBY2:	MOVE	A,C
	AND	A,WMASK(I)
	MOVEM	A,(T1)
	ADDI	T1,1
	MOVE	B,NWID(I)
	LSH	C,(B)
	SUB	D,LWID(I)
	AOBJN	I,FFRBY1
	RSTREG
	RET

	LIT

	END
