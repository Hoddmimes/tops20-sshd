	TITLE	SSHUTL - TOPS-20 SSH server: random numbers, host key, output helpers

	SEARCH	MONSYM,MACSYM,SSHDEF
	SALL

	EXTERN	ALGHK,B1,EDPUB,FATAL,FPB,HCTX,HPK,HSK
	EXTERN	KEYFIL,KSB,KSBL,OBUF,OLEN,OPASZ,OSTR,POOL
	EXTERN	RCTR,RCTX,RTMP,S256F,S256I,S256U,U4,W2U4
	EXTERN	ISSESS
	INTERN	DECOUT,ERRMSG,LDHOST,PRHEX,PRSTR,PRTIP,R,RNDGET
	INTERN	RNDINI,RNDTIM,RSKP,RNDMIX

SUBTTL	Random numbers

;The pool is SHA-256 over everything mixed in.  Sources: date/time,
;milliseconds since boot, the high-precision timer, CPU runtime, job
;number, and the timer at every packet arrival.

RNDINI:	SETZM	RCTR
	MOVEI	T1,POOL
	MOVEI	T2,^D32
RNDIN1:	SETZM	(T1)
	ADDI	T1,1
	SOJG	T2,RNDIN1
	GTAD%
	CALL	RNDMIX
	TIME%
	CALL	RNDMIX
	MOVEI	T1,.FHSLF
	RUNTM%
	CALL	RNDMIX
	GJINF%
	MOVE	T1,T3		;Job number
	CALL	RNDMIX
	MOVEI	Q1,^D16		;Timer jitter
RNDIN2:	CALL	RNDTIM
	SOJG	Q1,RNDIN2
	RET

;RNDTIM - mix the high-precision timer into the pool

RNDTIM:	MOVEI	T1,.HPELP
	HPTIM%
	 ERJMP	RNDTI1
	JRST	RNDMIX
RNDTI1:	TIME%			;No HPTIM%: use the millisecond clock
;	JRST	RNDMIX		;(falls through)

;RNDMIX - pool := SHA-256(pool || T1 as 4 bytes || T1 high bits)

RNDMIX:	PUSH	P,T1
	MOVEI	T1,RCTX
	CALL	S256I
	MOVEI	T1,RCTX
	MOVEI	T2,POOL
	MOVEI	T3,^D32
	CALL	S256U
	MOVE	T1,(P)
	CALL	W2U4
	MOVEI	T1,RCTX
	MOVEI	T2,U4
	MOVEI	T3,4
	CALL	S256U
	POP	P,T1
	LSH	T1,-^D32
	CALL	W2U4
	MOVEI	T1,RCTX
	MOVEI	T2,U4
	MOVEI	T3,1
	CALL	S256U
	MOVEI	T1,RCTX
	MOVEI	T2,POOL
	CALL	S256F
	RET

;RNDGET - T1/ destination, T2/ count: random bytes

RNDGET:	JUMPLE	T2,R
	PUSH	P,T1
	PUSH	P,T2
	AOS	T1,RCTR		;Output block = SHA-256(pool || ctr || 'o')
	CALL	W2U4
	MOVEI	T1,RCTX
	CALL	S256I
	MOVEI	T1,RCTX
	MOVEI	T2,POOL
	MOVEI	T3,^D32
	CALL	S256U
	MOVEI	T1,RCTX
	MOVEI	T2,U4
	MOVEI	T3,4
	CALL	S256U
	MOVEI	T1,"o"
	MOVEM	T1,B1
	MOVEI	T1,RCTX
	MOVEI	T2,B1
	MOVEI	T3,1
	CALL	S256U
	MOVEI	T1,RCTX
	MOVEI	T2,RTMP
	CALL	S256F
	MOVE	T1,RCTR		;Then move the pool on
	CALL	RNDMIX
	POP	P,T2
	POP	P,T1
	MOVSI	T3,-^D32	;Copy up to 32 bytes
RNDGE1:	MOVE	T4,RTMP(T3)
	MOVEM	T4,(T1)
	ADDI	T1,1
	SOJLE	T2,R
	AOBJN	T3,RNDGE1
	JRST	RNDGET

SUBTTL	Host key

;LDHOST - read SSHD-HOST-KEY.TXT (64 hex digits) or create it, then
;compute the public key, the K_S blob, and print the fingerprint.

LDHOST:	MOVX	T1,GJ%OLD!GJ%SHT
	HRROI	T2,KEYFIL
	GTJFN%
	 ERJMP	NEWKEY		;No file: make a key
	MOVE	Q3,T1
	MOVX	T2,FLD(7,OF%BSZ)!OF%RD
	OPENF%
	 ERJMP	FATAL
	MOVSI	Q1,-^D32
LDHOS1:	CALL	RDHEX		;Two hex digits per byte
	LSH	T2,4
	MOVE	Q2,T2
	CALL	RDHEX
	IOR	Q2,T2
	MOVEM	Q2,HSK(Q1)
	AOBJN	Q1,LDHOS1
	MOVE	T1,Q3
	CLOSF%
	 ERJMP	.+1
	SKIPE	ISSESS		;(Session forks load it quietly)
	 JRST	LDHOS3
	TMSG	<[Host key loaded from SSHD-HOST-KEY.TXT]
>
	JRST	LDHOS3

NEWKEY:	MOVEI	T1,HSK		;New random secret
	MOVEI	T2,^D32
	CALL	RNDGET
	MOVX	T1,GJ%FOU!GJ%SHT
	HRROI	T2,KEYFIL
	GTJFN%
	 ERJMP	FATAL
	MOVE	Q3,T1
	MOVX	T2,FLD(7,OF%BSZ)!OF%WR
	OPENF%
	 ERJMP	FATAL
	MOVSI	Q1,-^D32
NEWKE1:	MOVE	T2,HSK(Q1)
	LSH	T2,-4
	CALL	WRHEX
	MOVE	T2,HSK(Q1)
	ANDI	T2,17
	CALL	WRHEX
	AOBJN	Q1,NEWKE1
	MOVE	T1,Q3
	MOVEI	T2,15
	BOUT%
	MOVEI	T2,12
	BOUT%
	MOVE	T1,Q3		;Protection 770000: owner only
	TXO	T1,FLD(.FBPRT,CF%DSP)
	MOVEI	T2,777777
	MOVEI	T3,770000
	CHFDB%
	 ERJMP	.+1
	MOVE	T1,Q3
	CLOSF%
	 ERJMP	.+1
	TMSG	<[New host key written to SSHD-HOST-KEY.TXT]
>

LDHOS3:	MOVEI	T1,HPK		;Public key
	MOVEI	T2,HSK
	CALL	EDPUB
	SETZM	OLEN		;K_S = string "ssh-ed25519", string pk
	MOVEI	T2,ALGHK
	CALL	OPASZ
	MOVEI	T2,HPK
	MOVEI	T3,^D32
	CALL	OSTR
	MOVE	T1,OLEN
	MOVEM	T1,KSBL
	SETZ	T2,
LDHOS4:	MOVE	T3,OBUF(T2)
	MOVEM	T3,KSB(T2)
	ADDI	T2,1
	CAMGE	T2,T1
	 JRST	LDHOS4
	MOVEI	T1,HCTX		;Fingerprint = SHA-256(K_S), base64
	CALL	S256I
	MOVEI	T1,HCTX
	MOVEI	T2,KSB
	MOVE	T3,KSBL
	CALL	S256U
	MOVEI	T1,HCTX
	MOVEI	T2,FPB
	CALL	S256F
	SKIPE	ISSESS
	 RET
	TMSG	<Host key: ssh-ed25519 SHA256:>
	MOVEI	T2,FPB
	MOVEI	T3,^D32
	CALL	PRB64
	TMSG	<
>
	RET

;RDHEX - T2 := value of the next hex digit from file Q3

RDHEX:	MOVE	T1,Q3
	BIN%
	 ERJMP	FATAL
	CAIL	T2,"a"
	 SUBI	T2,40		;Upper case
	CAIL	T2,"A"
	 SUBI	T2,"A"-"9"-1
	SUBI	T2,"0"
	ANDI	T2,17
	RET

;WRHEX - write hex digit T2 to file Q3

WRHEX:	MOVE	T1,Q3
	CAIL	T2,^D10
	 ADDI	T2,"a"-"0"-^D10
	ADDI	T2,"0"
	BOUT%
	RET

SUBTTL	Output helpers

;PRSTR - print T3 bytes at T2 (printable ASCII only).  Preserves T2, T3.

PRSTR:	PUSH	P,T2
	PUSH	P,T3
PRSTR1:	SOJL	T3,PRSTR2
	MOVE	T1,(T2)
	CAIL	T1," "
	 CAILE	T1,"~"
	  MOVEI	T1,"."
	PBOUT%
	AOJA	T2,PRSTR1
PRSTR2:	POP	P,T3
	POP	P,T2
	RET

;PRHEX - print T3 bytes at T2 in hex, CR LF

PRHEX:	SOJL	T3,PRHEX1
	PUSH	P,T2
	PUSH	P,T3
	MOVE	T2,(T2)
	MOVEI	T1,.PRIOU
	MOVX	T3,NO%LFL!NO%ZRO!FLD(2,NO%COL)!^D16
	NOUT%
	 JFCL
	POP	P,T3
	POP	P,T2
	AOJA	T2,PRHEX
PRHEX1:	TMSG	<
>
	RET

;PRB64 - print T3 bytes at T2 in base64 without padding

PRB64:	PUSH	P,Q1
	PUSH	P,Q2
	MOVE	Q1,T2
	MOVE	Q2,T3
PRB641:	JUMPLE	Q2,PRB649
	MOVE	T4,(Q1)		;Collect up to 3 bytes in T4
	LSH	T4,^D8
	CAIL	Q2,2
	 IOR	T4,1(Q1)
	LSH	T4,^D8
	CAIL	Q2,3
	 IOR	T4,2(Q1)
	MOVEI	T3,4		;Characters to print
	CAIGE	Q2,3
	 MOVEI	T3,3
	CAIGE	Q2,2
	 MOVEI	T3,2
	MOVNI	T2,^D18
PRB642:	MOVE	T1,T4
	LSH	T1,(T2)
	ANDI	T1,77
	CALL	B64CH
	PBOUT%
	ADDI	T2,6
	SOJG	T3,PRB642
	ADDI	Q1,3
	SUBI	Q2,3
	JRST	PRB641
PRB649:	POP	P,Q2
	POP	P,Q1
	RET

;B64CH - T1 := base64 character for the 6-bit value in T1

B64CH:	CAIGE	T1,^D26
	 JRST	[ADDI	T1,"A"
		 RET]
	CAIGE	T1,^D52
	 JRST	[ADDI	T1,"a"-^D26
		 RET]
	CAIGE	T1,^D62
	 JRST	[ADDI	T1,"0"-^D52
		 RET]
	CAIN	T1,^D62
	 SKIPA	T1,["+"]
	  MOVEI	T1,"/"
	RET

;DECOUT - print T2 in decimal

DECOUT:	MOVEI	T1,.PRIOU
	MOVEI	T3,^D10
	NOUT%
	 JFCL
	RET

;PRTIP - print the IPv4 address in Q1

PRTIP:	MOVEI	T4,^D24
PRTIP1:	MOVE	T2,Q1
	MOVN	T3,T4
	LSH	T2,(T3)
	ANDI	T2,377
	CALL	DECOUT
	JUMPE	T4,R
	MOVEI	T1,"."
	PBOUT%
	SUBI	T4,^D8
	JRST	PRTIP1

;ERRMSG - print the last JSYS error

ERRMSG:	TMSG	<?>
	MOVEI	T1,.PRIOU
	HRLOI	T2,.FHSLF
	SETZ	T3,
	ERSTR%
	 JFCL
	 JFCL
	TMSG	<
>
	RET

R:	RET
RSKP:	AOS	(P)
	RET


	LIT

	END
