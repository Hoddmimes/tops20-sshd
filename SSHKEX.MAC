	TITLE	SSHKEX - TOPS-20 SSH server: key exchange

	SEARCH	MONSYM,MACSYM,SSHDEF
	SALL

	EXTERN	ALGCMP,ALGENC,ALGHK,ALGKEX,ALGKX1,ALGKX2,ALGMAC,B1
	EXTERN	GPSTR,HCTX,HH,IC,ICLEN,IS,ISLEN,KMP
	EXTERN	KMPL,KSB,KSBL,KSEC,OBUF,OLEN,OP32,OPASZ
	EXTERN	OPB,QCB,QSB,RIX,RNDGET,S256F,S256I,S256U
	EXTERN	SID,U4,VC,VCLEN,VS,VSLEN,W2U4
	INTERN	CHKALG,EXHASH,KDF,MKKEXI,MKKMP

SUBTTL	KEXINIT, algorithm check, exchange hash, key derivation

;MKKEXI - build our KEXINIT in OBUF and keep a copy in IS

MKKEXI:	SETZM	OLEN
	MOVEI	T1,SSHKEX
	CALL	OPB
	MOVEI	T1,OBUF+1	;Cookie: 16 random bytes
	MOVEI	T2,^D16
	CALL	RNDGET
	MOVEI	T1,^D17
	MOVEM	T1,OLEN
	MOVEI	T2,ALGKEX
	CALL	OPASZ
	MOVEI	T2,ALGHK
	CALL	OPASZ
	MOVEI	T2,ALGENC	;Ciphers c->s, s->c
	CALL	OPASZ
	MOVEI	T2,ALGENC
	CALL	OPASZ
	MOVEI	T2,ALGMAC	;MACs (ignored with an AEAD cipher)
	CALL	OPASZ
	MOVEI	T2,ALGMAC
	CALL	OPASZ
	MOVEI	T2,ALGCMP
	CALL	OPASZ
	MOVEI	T2,ALGCMP
	CALL	OPASZ
	SETZ	T1,		;Languages: empty
	CALL	OP32
	SETZ	T1,
	CALL	OP32
	SETZ	T1,		;first_kex_packet_follows
	CALL	OPB
	SETZ	T1,		;reserved
	CALL	OP32
	MOVE	T1,OLEN
	MOVEM	T1,ISLEN
	SETZ	Q1,
MKKEX1:	MOVE	T2,OBUF(Q1)
	MOVEM	T2,IS(Q1)
	ADDI	Q1,1
	CAMGE	Q1,T1
	 JRST	MKKEX1
	RET

;CHKALG - check the client's KEXINIT (in PAY) offers what we need.
;Skip return if so.

CHKALG:	MOVEI	T1,^D17		;Skip type and cookie
	MOVEM	T1,RIX
	CALL	GPSTR		;kex_algorithms
	 RET
	HRROI	T1,ALGKX1
	CALL	LSTHAS
	 SKIPA
	JRST	CHKAL1
	HRROI	T1,ALGKX2
	CALL	LSTHAS
	 RET
CHKAL1:	CALL	GPSTR		;server_host_key_algorithms
	 RET
	HRROI	T1,ALGHK
	CALL	LSTHAS
	 RET
	CALL	GPSTR		;ciphers c->s
	 RET
	HRROI	T1,ALGENC
	CALL	LSTHAS
	 RET
	CALL	GPSTR		;ciphers s->c
	 RET
	HRROI	T1,ALGENC
	CALL	LSTHAS
	 RET
	CALL	GPSTR		;MACs c->s: ignored with chacha20-poly1305
	 RET
	CALL	GPSTR		;MACs s->c
	 RET
	CALL	GPSTR		;compression c->s
	 RET
	HRROI	T1,ALGCMP
	CALL	LSTHAS
	 RET
	CALL	GPSTR		;compression s->c
	 RET
	HRROI	T1,ALGCMP
	CALL	LSTHAS
	 RET
	RETSKP

;LSTHAS - is the ASCIZ name at T1 an element of the name-list at
;T2 (bytes), length T3?  Skip return if so.  Preserves T2, T3.

LSTHAS:	PUSH	P,T2
	PUSH	P,T3
	PUSH	P,Q1
	PUSH	P,Q2
	HRLI	T1,(POINT 7,)
	MOVE	Q2,T1		;Name pointer
LSTHA1:	MOVE	T4,Q2		;Compare one element
LSTHA2:	ILDB	Q1,T4		;Next name character
	JUMPLE	T3,LSTHA3	;End of list
	MOVE	T1,(T2)
	CAIN	T1,","		;End of element
	 JRST	LSTHA3
	CAME	T1,Q1		;Mismatch?
	 JRST	LSTHA4		;Yes, skip to the next element
	ADDI	T2,1
	SOJA	T3,LSTHA2
LSTHA3:	JUMPE	Q1,LSTHA6	;Element ended with the name: match
LSTHA4:	JUMPLE	T3,LSTHA5	;Skip past the next comma
	MOVE	T1,(T2)
	ADDI	T2,1
	SUBI	T3,1
	CAIE	T1,","
	 JRST	LSTHA4
	JRST	LSTHA1
LSTHA6:	AOS	-4(P)		;Skip return
LSTHA5:	POP	P,Q2
	POP	P,Q1
	POP	P,T3
	POP	P,T2
	RET

;MKKMP - KMP := K as mpint body (leading zeros dropped, 0 added if
;the top bit is set).  RFC 8731: the X25519 output bytes are taken as
;a big-endian number.

MKKMP:	SETZ	Q1,		;Skip leading zero bytes
MKKMP1:	CAIGE	Q1,^D32
	 SKIPE	KSEC(Q1)
	  JRST	MKKMP2
	AOJA	Q1,MKKMP1
MKKMP2:	SETZ	Q2,		;Output index
	MOVE	T1,KSEC(Q1)
	TRNN	T1,200		;Top bit set?
	 JRST	MKKMP3
	SETZM	KMP		;Yes, leading zero byte
	MOVEI	Q2,1
MKKMP3:	CAIL	Q1,^D32
	 JRST	MKKMP4
	MOVE	T1,KSEC(Q1)
	MOVEM	T1,KMP(Q2)
	ADDI	Q1,1
	AOJA	Q2,MKKMP3
MKKMP4:	MOVEM	Q2,KMPL
	RET

;EXHASH - HH := SHA-256(V_C, V_S, I_C, I_S, K_S, Q_C, Q_S, K)
;(all as SSH strings; K as mpint)

EXHASH:	MOVEI	T1,HCTX
	CALL	S256I
	MOVEI	T2,VC
	MOVE	T3,VCLEN
	CALL	HSTR
	MOVEI	T2,VS
	MOVE	T3,VSLEN
	CALL	HSTR
	MOVEI	T2,IC
	MOVE	T3,ICLEN
	CALL	HSTR
	MOVEI	T2,IS
	MOVE	T3,ISLEN
	CALL	HSTR
	MOVEI	T2,KSB
	MOVE	T3,KSBL
	CALL	HSTR
	MOVEI	T2,QCB
	MOVEI	T3,^D32
	CALL	HSTR
	MOVEI	T2,QSB
	MOVEI	T3,^D32
	CALL	HSTR
	MOVEI	T2,KMP
	MOVE	T3,KMPL
	CALL	HSTR
	MOVEI	T1,HCTX
	MOVEI	T2,HH
	CALL	S256F
	RET

;HSTR - hash T3 bytes at T2 into HCTX as an SSH string

HSTR:	PUSH	P,T2
	PUSH	P,T3
	MOVE	T1,T3
	CALL	W2U4
	MOVEI	T1,HCTX
	MOVEI	T2,U4
	MOVEI	T3,4
	CALL	S256U
	MOVEI	T1,HCTX
	POP	P,T3
	POP	P,T2
	CALL	S256U
	RET

;KDF - derive a 64-byte chacha20-poly1305 key.  T1/ letter, T2/ out
;  out[0..31]  = SHA-256(K || H || letter || session_id)
;  out[32..63] = SHA-256(K || H || out[0..31])

KDF:	PUSH	P,T2
	MOVEM	T1,B1
	MOVEI	T1,HCTX
	CALL	S256I
	MOVEI	T2,KMP
	MOVE	T3,KMPL
	CALL	HSTR
	MOVEI	T1,HCTX
	MOVEI	T2,HH
	MOVEI	T3,^D32
	CALL	S256U
	MOVEI	T1,HCTX
	MOVEI	T2,B1
	MOVEI	T3,1
	CALL	S256U
	MOVEI	T1,HCTX
	MOVEI	T2,SID
	MOVEI	T3,^D32
	CALL	S256U
	MOVEI	T1,HCTX
	MOVE	T2,(P)
	CALL	S256F
	MOVEI	T1,HCTX
	CALL	S256I
	MOVEI	T2,KMP
	MOVE	T3,KMPL
	CALL	HSTR
	MOVEI	T1,HCTX
	MOVEI	T2,HH
	MOVEI	T3,^D32
	CALL	S256U
	MOVEI	T1,HCTX
	MOVE	T2,(P)
	MOVEI	T3,^D32
	CALL	S256U
	MOVEI	T1,HCTX
	POP	P,T2
	ADDI	T2,^D32
	CALL	S256F
	RET


	LIT

	END
